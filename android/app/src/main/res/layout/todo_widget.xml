<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget layout using FrameLayout so a real wallpaper ImageView sits
  behind the content overlay. Multi-line task text wrapping enabled with
  top-aligned bullet indicators.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_corner_clip">

    <!-- ── Wallpaper: actual PNG/JPG image per theme (centerCrop fills card) ── -->
    <ImageView
        android:id="@+id/img_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wp_midnight"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false" />

    <!-- ── Dark translucent scrim so text is always readable ── -->
    <LinearLayout
        android:id="@+id/scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header Row: Title, Count Badge, Quick-Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏴 Bounty Board"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/tv_widget_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_add_task"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:background="@drawable/btn_widget_midnight" />
        </LinearLayout>

        <!-- Divider -->
        <ImageView
            android:id="@+id/img_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:background="#55FFFFFF" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No bounties posted! Tap + to add one 🎉"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="visible" />

        <!-- Task List Container -->
        <LinearLayout
            android:id="@+id/task_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Task Row 1 -->
            <LinearLayout android:id="@+id/task_row_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView android:id="@+id/task_bullet_1"
                    android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="top"
                    android:src="@drawable/bullet_widget_midnight" />
                <TextView android:id="@+id/task_text_1"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="13sp"
                    android:shadowColor="#FF000000" android:shadowDx="1"
                    android:shadowDy="1" android:shadowRadius="2"/>
            </LinearLayout>

            <!-- Task Row 2 -->
            <LinearLayout android:id="@+id/task_row_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView android:id="@+id/task_bullet_2"
                    android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="top"
                    android:src="@drawable/bullet_widget_midnight" />
                <TextView android:id="@+id/task_text_2"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="13sp"
                    android:shadowColor="#FF000000" android:shadowDx="1"
                    android:shadowDy="1" android:shadowRadius="2"/>
            </LinearLayout>

            <!-- Task Row 3 -->
            <LinearLayout android:id="@+id/task_row_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView android:id="@+id/task_bullet_3"
                    android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="top"
                    android:src="@drawable/bullet_widget_midnight" />
                <TextView android:id="@+id/task_text_3"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="13sp"
                    android:shadowColor="#FF000000" android:shadowDx="1"
                    android:shadowDy="1" android:shadowRadius="2"/>
            </LinearLayout>

            <!-- Task Row 4 -->
            <LinearLayout android:id="@+id/task_row_4"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView android:id="@+id/task_bullet_4"
                    android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="top"
                    android:src="@drawable/bullet_widget_midnight" />
                <TextView android:id="@+id/task_text_4"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="13sp"
                    android:shadowColor="#FF000000" android:shadowDx="1"
                    android:shadowDy="1" android:shadowRadius="2"/>
            </LinearLayout>

            <!-- Task Row 5 -->
            <LinearLayout android:id="@+id/task_row_5"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:visibility="gone">
                <ImageView android:id="@+id/task_bullet_5"
                    android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="top"
                    android:src="@drawable/bullet_widget_midnight" />
                <TextView android:id="@+id/task_text_5"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFFFF" android:textSize="13sp"
                    android:shadowColor="#FF000000" android:shadowDx="1"
                    android:shadowDy="1" android:shadowRadius="2"/>
            </LinearLayout>

            <!-- More Tasks Indicator -->
            <TextView
                android:id="@+id/tv_more_tasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
